---
import { menu } from '../lib/content';
import { site } from '../lib/site';
import Icon from './Icon.astro';

const main = menu('main-menu');
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === currentPath;
---
<header class="site-header" data-header>
  <div class="site-header__inner container container--wide">
    <a class="site-header__logo" href="/">
      <img src={site.logo} alt={`${site.name} — ${site.tagline}`} width="220" height="85" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {main.map((item) => (
          <li class={`site-nav__item ${item.children.length ? 'has-children' : ''}`}>
            {item.href ? (
              <a
                class="site-nav__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                set:html={item.label}
              />
            ) : (
              <span class="site-nav__link site-nav__link--static" set:html={item.label} />
            )}
            {item.children.length > 0 && (
              <ul class="site-nav__sub">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href ?? '#'} aria-current={child.href && isCurrent(child.href) ? 'page' : undefined} set:html={child.label} />
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <a class="site-header__phone" href={site.phoneHref}>
        <Icon name="phone" size={15} strokeWidth={2.25} />
        {site.phone}
      </a>
      <a class="btn btn--accent btn--small" href="/get-a-quote/">Get a Quote</a>
    </div>

    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
      <span class="sr-only">Menu</span>
      <span class="site-header__bars" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" hidden data-mobile-nav>
    <ul>
      {main.map((item) => (
        <li>
          {item.href ? <a href={item.href} set:html={item.label} /> : <span class="mobile-nav__label" set:html={item.label} />}
          {item.children.length > 0 && (
            <ul>
              {item.children.map((child) => (
                <li><a href={child.href ?? '#'} set:html={child.label} /></li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="mobile-nav__cta">
      <a class="btn btn--accent btn--medium" href="/get-a-quote/">Get a Quote</a>
      <a class="btn btn--dark btn--medium" href={site.phoneHref}>{site.phone}</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.hidden = open;
      document.body.classList.toggle('nav-open', !open);
    });
  }

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 60);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /*
   * Dark header. The logo is drawn for a dark ground: its keyline and the
   * "Lifting" script are white, so on a light header both vanish and only
   * "LANDMARK" reads. Dark also ties the header to the hero and footer.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(26, 23, 23, 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: background-color var(--transition), box-shadow var(--transition),
      border-color var(--transition);
  }
  .site-header.is-scrolled {
    background: rgba(20, 17, 17, 0.97);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    min-height: var(--header-height);
    transition: min-height var(--transition);
  }
  .site-header.is-scrolled .site-header__inner {
    min-height: var(--header-height-scrolled);
  }

  .site-header__logo {
    flex: 0 0 auto;
    line-height: 0;
  }
  .site-header__logo img {
    height: 72px;
    width: auto;
    max-width: none;
    transition: height var(--transition);
  }
  .site-header.is-scrolled .site-header__logo img {
    height: 50px;
  }

  .site-nav {
    margin-left: auto;
    min-width: 0;
  }
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__item {
    position: relative;
    margin: 0;
  }
  .site-nav__link {
    display: block;
    padding: 10px 12px;
    font-family: var(--font-head);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    white-space: nowrap;
    border-radius: var(--radius-sm);
    transition: color var(--transition);
  }
  .site-nav__link:hover,
  .site-nav__item:hover > .site-nav__link,
  .site-nav__link[aria-current='page'] {
    color: var(--accent);
  }
  .site-nav__link[aria-current='page']::after {
    content: '';
    display: block;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
    margin-top: 4px;
  }
  .site-nav__link--static {
    cursor: default;
  }
  .site-nav__item.has-children > .site-nav__link {
    padding-right: 22px;
  }
  .site-nav__item.has-children > .site-nav__link::before {
    content: '';
    position: absolute;
    right: 9px;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -4px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.6;
    transition: transform var(--transition);
  }
  .site-nav__item.has-children:hover > .site-nav__link::before {
    transform: rotate(225deg);
    margin-top: -1px;
  }

  .site-nav__sub {
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    min-width: 290px;
    background: #1a1717;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    list-style: none;
    margin: 0;
    padding: 6px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }
  .site-nav__item:hover .site-nav__sub,
  .site-nav__item:focus-within .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .site-nav__sub li {
    margin: 0;
  }
  .site-nav__sub a {
    display: block;
    padding: 9px 14px;
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.35;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition), color var(--transition);
  }
  .site-nav__sub a:hover,
  .site-nav__sub a[aria-current='page'] {
    background: rgba(241, 92, 40, 0.16);
    color: var(--accent);
  }

  .site-header__cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 0 0 auto;
  }
  .site-header__phone {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
    color: #fff;
    white-space: nowrap;
  }
  .site-header__phone svg {
    color: var(--accent);
    flex: 0 0 auto;
  }
  .site-header__phone:hover {
    color: var(--accent);
  }

  .site-header__toggle {
    display: none;
    appearance: none;
    background: none;
    border: 0;
    color: #fff;
    padding: 12px 8px;
    cursor: pointer;
    margin-left: auto;
  }
  .site-header__bars,
  .site-header__bars::before,
  .site-header__bars::after {
    display: block;
    width: 26px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    position: relative;
    transition: transform var(--transition), opacity var(--transition);
  }
  .site-header__bars::before,
  .site-header__bars::after {
    content: '';
    position: absolute;
  }
  .site-header__bars::before { top: -8px; }
  .site-header__bars::after { top: 8px; }
  [aria-expanded='true'] .site-header__bars {
    background: transparent;
  }
  [aria-expanded='true'] .site-header__bars::before {
    top: 0;
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .site-header__bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: #1a1717;
    max-height: calc(100vh - var(--header-height-scrolled));
    overflow-y: auto;
    padding-bottom: var(--space-md);
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav li { margin: 0; }
  .mobile-nav a,
  .mobile-nav__label {
    display: block;
    padding: 14px var(--gutter);
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mobile-nav a:hover {
    color: var(--accent);
  }
  .mobile-nav__label {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 0;
  }
  .mobile-nav ul ul a {
    padding-left: calc(var(--gutter) + 16px);
    font-size: 0.9375rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.7);
  }
  .mobile-nav__cta {
    display: flex;
    gap: 10px;
    padding: var(--space-md) var(--gutter) 0;
  }
  .mobile-nav__cta .btn {
    flex: 1;
  }

  @media (max-width: 1100px) {
    .site-nav,
    .site-header__cta { display: none; }
    .site-header__toggle { display: block; }
  }
</style>
