---
/**
 * First-touch attribution capture.
 *
 * Rebuilt to match what the original Gravity Forms actually did. The old form's
 * five hidden fields held Google Analytics `__utmz` cookie values — `google`,
 * `organic`, `(direct)`, `(not set)` — not raw URL parameters. That is why 65%
 * of 1,733 entries carried attribution even though most visitors submit from a
 * clean URL: something read their *stored* attribution rather than the current
 * query string.
 *
 * So: capture on first landing, persist, and reuse. Reading `?utm_source=` off
 * the current URL would only ever attribute the minority who submit on the same
 * page they landed on.
 *
 * Two rules taken from auditing the old entries:
 *   - 90-day window, matching the old GA attribution window. localStorage with
 *     an explicit expiry, since sessionStorage would drop attribution the
 *     moment someone closes the tab and comes back to submit.
 *   - Never write the literal string "undefined". The old form did, 52 times in
 *     Source, 400 in Keyword and 493 in GCLID, from stringifying an undefined
 *     variable. A missing value posts as empty here.
 */
---

<script is:inline>
  (function () {
    var KEY = 'll_attr';
    var NINETY_DAYS = 90 * 24 * 60 * 60 * 1000;

    /** Search engines that should read as organic rather than referral. */
    var SEARCH = {
      'google.': 'google',
      'bing.': 'bing',
      'duckduckgo.': 'duckduckgo.com',
      'yahoo.': 'yahoo',
      'ecosia.': 'ecosia',
      'brave.': 'brave',
      'startpage.': 'startpage',
      'baidu.': 'baidu',
      'yandex.': 'yandex',
    };

    /** Trim, and never let `undefined`/`null` through as text. */
    function clean(v) {
      if (v === undefined || v === null) return '';
      var s = String(v).trim();
      if (s === 'undefined' || s === 'null') return '';
      return s.slice(0, 255);
    }

    try {
      var stored = null;
      try {
        var raw = localStorage.getItem(KEY);
        if (raw) {
          var parsed = JSON.parse(raw);
          // Expire past the 90-day window rather than attributing a lead to a
          // campaign from three months ago.
          if (parsed && parsed.t && Date.now() - parsed.t < NINETY_DAYS) stored = parsed;
        }
      } catch (e) {
        /* unreadable or corrupt — fall through and capture fresh */
      }

      // First touch wins. Once a visit is attributed, later page views and
      // later campaigns never overwrite it.
      if (stored) return;

      var params = new URLSearchParams(window.location.search);
      var ref = clean(document.referrer);
      var refHost = '';
      if (ref) {
        try {
          refHost = new URL(ref).hostname.toLowerCase();
        } catch (e) {
          refHost = '';
        }
      }
      var internal = refHost && refHost.indexOf(window.location.hostname) !== -1;

      var gclid = clean(params.get('gclid'));
      var gbraid = clean(params.get('gbraid'));
      var wbraid = clean(params.get('wbraid'));

      // Source: explicit param, else derive from the referrer, else direct.
      var source = clean(params.get('utm_source'));
      if (!source) {
        if (gclid || gbraid || wbraid) {
          source = 'google';
        } else if (refHost && !internal) {
          source = refHost.replace(/^www\./, '');
          for (var frag in SEARCH) {
            if (refHost.indexOf(frag) !== -1) {
              source = SEARCH[frag];
              break;
            }
          }
        } else {
          source = '(direct)';
        }
      }

      // Medium: explicit param, else infer. Paid clicks carry a click ID.
      var medium = clean(params.get('utm_medium'));
      if (!medium) {
        if (gclid || gbraid || wbraid) {
          medium = 'cpc';
        } else if (refHost && !internal) {
          var isSearch = false;
          for (var f in SEARCH) {
            if (refHost.indexOf(f) !== -1) isSearch = true;
          }
          medium = isSearch ? 'organic' : 'referral';
        } else {
          medium = '(none)';
        }
      }

      var attr = {
        t: Date.now(),
        utm_source: source,
        utm_medium: medium,
        utm_campaign: clean(params.get('utm_campaign')) || '(not set)',
        utm_term: clean(params.get('utm_term')),
        utm_content: clean(params.get('utm_content')),
        gclid: gclid,
        gbraid: gbraid,
        wbraid: wbraid,
        landing_page: window.location.pathname + window.location.search,
        referrer: internal ? '' : ref,
      };

      localStorage.setItem(KEY, JSON.stringify(attr));
    } catch (e) {
      // Private mode, storage disabled, or quota exceeded. Forms still submit,
      // just without attribution — never let this break the page.
    }
  })();
</script>
