---
/**
 * First-touch attribution capture.
 *
 * Runs on every page. An ad click almost never lands on the page with the form
 * on it — it lands on a service or location page, the visitor reads, then
 * navigates to /contact/ or /get-a-quote/ and submits. By then the query string
 * that identified the campaign is gone.
 *
 * So the first page of the session records the campaign parameters into
 * sessionStorage, and NetlifyForm reads them back at submit time. First touch
 * wins: a later internal page view never overwrites what brought them in.
 *
 * sessionStorage (not localStorage) is deliberate — attribution should describe
 * this visit, not one from three weeks ago.
 */
---

<script is:inline>
  (function () {
    var KEY = 'll_attr';
    try {
      // First touch wins — never overwrite an existing record.
      if (sessionStorage.getItem(KEY)) return;

      var params = new URLSearchParams(window.location.search);
      var attr = {};
      var keys = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_term',
        'utm_content',
        'gclid',
        'gbraid',
        'wbraid',
        'fbclid',
      ];
      for (var i = 0; i < keys.length; i++) {
        var v = params.get(keys[i]);
        if (v) attr[keys[i]] = v.slice(0, 255);
      }

      attr.first_landing_page = window.location.pathname + window.location.search;

      // An internal referrer means this is not the entry page; leave it blank
      // rather than reporting the site as its own traffic source.
      var ref = document.referrer || '';
      if (ref && ref.indexOf(window.location.host) === -1) {
        attr.referrer = ref.slice(0, 255);
      }

      sessionStorage.setItem(KEY, JSON.stringify(attr));
    } catch (e) {
      // Private mode or storage disabled — forms still submit, just without
      // attribution. Never let this break the page.
    }
  })();
</script>
