---
/**
 * Renders an icon from a real icon library — Lucide for interface and concept
 * icons, Bootstrap Icons for brand marks. The geometry is read from the
 * installed package at build time, so it is the library's own artwork.
 */
import { getIcon, type IconSet } from '../lib/icons';

interface Props {
  name: string;
  set?: IconSet;
  size?: number;
  /** Accessible label. Omit for icons that sit beside visible text. */
  label?: string;
  class?: string;
  strokeWidth?: number;
}
const { name, set = 'lucide', size = 24, label, class: className, strokeWidth } = Astro.props;

const icon = getIcon(name, set);
if (!icon && import.meta.env.DEV) {
  console.warn(`[Icon] "${name}" not found in the ${set} set`);
}
---
{
  icon && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox={icon.viewBox}
      fill={icon.stroked ? 'none' : 'currentColor'}
      stroke={icon.stroked ? 'currentColor' : undefined}
      stroke-width={icon.stroked ? (strokeWidth ?? 2) : undefined}
      stroke-linecap={icon.stroked ? 'round' : undefined}
      stroke-linejoin={icon.stroked ? 'round' : undefined}
      role={label ? 'img' : undefined}
      aria-label={label}
      aria-hidden={label ? undefined : 'true'}
      focusable="false"
      set:html={icon.body}
    />
  )
}
