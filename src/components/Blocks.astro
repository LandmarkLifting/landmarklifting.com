---
/**
 * Recursively renders the shortcode tree parsed out of the original
 * WPBakery / Salient page content.
 */
import type { Node } from '../lib/shortcode';
import { decodeRawHtml, parseShortcodes } from '../lib/shortcode';
import { cleanHtml, color, fontContainer, headingTag, internalHref, isLightColor, isProseHeading, spacing, widthPercent } from '../lib/render';
import { blocks, mediaAlt, mediaUrl } from '../lib/content';

import Row from './blocks/Row.astro';
import Figure from './blocks/Figure.astro';
import AnimatedTitle from './blocks/AnimatedTitle.astro';
import Button from './blocks/Button.astro';
import Compare from './blocks/Compare.astro';
import Toggles from './blocks/Toggles.astro';
import Gallery from './blocks/Gallery.astro';
import Cta from './blocks/Cta.astro';
import Testimonials from './blocks/Testimonials.astro';
import Tabs from './blocks/Tabs.astro';
import IconList from './blocks/IconList.astro';
import NetlifyForm from './blocks/NetlifyForm.astro';
import Submenu from './blocks/Submenu.astro';
import BlogFeed from './blocks/BlogFeed.astro';
import { posts, postsInCategory } from '../lib/content';
import NectarIcon from './blocks/NectarIcon.astro';
import ServiceAreaMap from './blocks/ServiceAreaMap.astro';
import Self from './Blocks.astro';

interface Props {
  nodes: Node[];
}
const { nodes } = Astro.props;

/**
 * Fractions that have a `.col--a_b` class in global.css. Those set --col-width
 * in a stylesheet so the responsive rules can override them; anything else
 * falls back to an inline width, which cannot be overridden but is rare.
 */
const KNOWN_WIDTHS = new Set([
  '1/1', '1/2', '1/3', '2/3', '1/4', '3/4', '1/5', '2/5', '3/5', '4/5',
  '1/6', '5/6', '1/12', '5/12', '7/12', '11/12',
]);

const isColumn = (c: Node) =>
  c.kind === 'tag' && (c.name === 'vc_column' || c.name === 'vc_column_inner');

/**
 * WPBakery centres content with empty spacer columns — `[1/4][1/2][1/4]` —
 * and authors leave columns empty when a layout was never finished. Rendering
 * them costs real width: the quote form's block is `[1/4][1/2 form][1/4]`, and
 * on pages where that block sits inside a half-width column with an empty
 * sibling, the form ends up in a quarter of the page. A column with no content
 * and no background of its own has nothing to show, so it is dropped, and a
 * column left on its own fills the row (see `.col--solo`).
 */
/** A post feed whose category has no posts in the rebuilt data renders nothing. */
const isEmptyFeed = (k: Node) => {
  if (k.kind !== 'tag' || k.name !== 'nectar_blog') return false;
  const cat = k.attrs.category?.trim();
  return (cat ? postsInCategory(cat) : posts).length === 0;
};

const isEmptyColumn = (c: Node) =>
  isColumn(c) &&
  c.kind === 'tag' &&
  !color(c.attrs.background_color) &&
  c.children.every((k) => (k.kind === 'html' && k.html.trim() === '') || isEmptyFeed(k));

/**
 * Shortcodes that produce a section of their own. Authors sometimes drop one
 * inside a text widget (`[vc_column_text][ls_content_block …][/vc_column_text]`);
 * rendered literally, the whole section inherits the text block's reading
 * measure and the quote form ends up 650px wide. They render as siblings.
 */
const isStructural = (k: Node) =>
  k.kind === 'tag' && ['vc_row', 'vc_row_inner', 'ls_content_block', 'nectar_blog'].includes(k.name);

/** Columns and rows carry structural attributes we translate into CSS. */
function columnStyle(attrs: Record<string, string>) {
  const styles: string[] = [];
  const width = (attrs.width || '').replace(/\s/g, '');
  // Only inline a width the stylesheet has no class for — an inline custom
  // property would otherwise beat every responsive rule.
  if (width && !KNOWN_WIDTHS.has(width)) {
    styles.push(`--col-width:${widthPercent(attrs.width)}`);
  }
  // A column that paints a background becomes a card: the colour, padding and
  // radius go on an inner box so the row's gutter stays visible between cards.
  const bg = color(attrs.background_color);
  if (bg) styles.push(`--col-bg:${bg}`);
  const pad = attrs.column_padding || '';
  const m = pad.match(/padding-(\d+)-percent/);
  if (m) styles.push(`--col-pad:${m[1]}%`);
  if (attrs.border_radius && attrs.border_radius !== 'none') {
    styles.push(`--col-radius:${attrs.border_radius}`);
  }
  return styles.join(';');
}
---
{
  nodes.map((node) => {
    if (node.kind === 'html') {
      return <Fragment set:html={cleanHtml(node.html)} />;
    }

    const { name, attrs, children } = node;

    switch (name) {
      // ---- structure ----------------------------------------------------
      case 'vc_row':
      case 'vc_row_inner': {
        // A row where EVERY column paints a background is a row of cards, and
        // cards share a height. One card beside plain text or a form must not
        // stretch — it just becomes a tall box with a void under its copy.
        const hasCards = children.filter(isColumn).length > 0 && children.filter(isColumn).every(
          (c) =>
            c.kind === 'tag' &&
            (c.name === 'vc_column' || c.name === 'vc_column_inner') &&
            Boolean(color(c.attrs.background_color)),
        );
        const cols = children.filter(isColumn);
        const kept = cols.filter((c) => !isEmptyColumn(c));
        // Every column empty (e.g. a feed for a category with no posts): the
        // row would be a blank band of padding. Skip it.
        if (cols.length > 0 && kept.length === 0) return null;
        for (const c of cols) {
          if (c.kind !== 'tag') continue;
          if (isEmptyColumn(c)) c.attrs._drop = '1';
          // One column left from several, and not already full width: fill.
          else if (kept.length === 1 && cols.length > 1 && (c.attrs.width || '').replace(/\s/g, '') !== '1/1')
            c.attrs._solo = '1';
        }
        return (
          <Row attrs={attrs} inner={name === 'vc_row_inner'} hasCards={hasCards}>
            <Self nodes={children} />
          </Row>
        );
      }

      case 'vc_column':
      case 'vc_column_inner': {
        // A column with its own background must set a readable text colour;
        // the row's light/dark setting does not know about it.
        if (attrs._drop) return null;
        const light = isLightColor(attrs.background_color);
        const rawWidth = (attrs.width || '').replace(/\s/g, '');
        const widthClass = KNOWN_WIDTHS.has(rawWidth) ? `col--${rawWidth.replace('/', '_')}` : '';
        // WPBakery's per-breakpoint visibility lives in `offset`.
        const hidden = (attrs.offset || '')
          .split(/\s+/)
          .filter((k) => /^vc_hidden-(xs|sm|md|lg)$/.test(k));
        const cls = [
          'col',
          widthClass,
          attrs._solo ? 'col--solo' : '',
          ...hidden,
          attrs.centered_text === 'true' ? 'text-center' : '',
          light === true ? 'col--light-bg' : light === false ? 'col--dark-bg' : '',
        ].filter(Boolean).join(' ');
        const boxed = light !== null;
        return boxed ? (
          <div class={cls} style={columnStyle(attrs)}>
            <div class="col__box">
              <Self nodes={children} />
            </div>
          </div>
        ) : (
          <div class={cls} style={columnStyle(attrs)}>
            <Self nodes={children} />
          </div>
        );
      }

      case 'vc_column_text': {
        const prose = children.filter((k) => !isStructural(k));
        const sections = children.filter(isStructural);
        const hasProse = prose.some((k) => k.kind !== 'html' || k.html.trim() !== '');
        return (
          <>
            {hasProse && (
              <div class="rich-text">
                <Self nodes={prose} />
              </div>
            )}
            {sections.length > 0 && <Self nodes={sections} />}
          </>
        );
      }

      // ---- text ---------------------------------------------------------
      case 'vc_custom_heading': {
        const f = fontContainer(attrs.font_container);
        const Tag = f.tag as any;
        const style = [
          f.color ? `color:${f.color}` : '',
          f.fontSize ? `font-size:${f.fontSize}` : '',
          f.lineHeight && f.lineHeight !== '0' ? `line-height:${f.lineHeight}` : '',
        ].filter(Boolean).join(';');
        const cls = [f.align ? `text-${f.align}` : '', isProseHeading(attrs.text) ? 'h--prose' : '']
          .filter(Boolean).join(' ') || undefined;
        const inner = attrs.link ? (
          <a href={internalHref(attrs.link.split('|')[0].replace(/^url:/, ''))} set:html={attrs.text} />
        ) : null;
        return inner
          ? <Tag class={cls} style={style}>{inner}</Tag>
          : <Tag class={cls} style={style} set:html={attrs.text ?? ''} />;
      }

      case 'nectar_animated_title':
        return <AnimatedTitle attrs={attrs} />;

      case 'split_line_heading': {
        const Tag = headingTag(attrs.font_style, 'h2') as any;
        const style = attrs.text_color ? `color:${attrs.text_color}` : undefined;
        const cls = [
          attrs.content_alignment && attrs.content_alignment !== 'default'
            ? `text-${attrs.content_alignment}` : '',
          isProseHeading(attrs.text_content) ? 'h--prose' : '',
        ].filter(Boolean).join(' ') || undefined;
        return <Tag class={cls} style={style} set:html={attrs.text_content ?? ''} />;
      }

      case 'nectar_dropcap':
        return (
          <span class="dropcap" style={color(attrs.color) ? `color:${color(attrs.color)}` : undefined}>
            <Self nodes={children} />
          </span>
        );

      // ---- media --------------------------------------------------------
      case 'image_with_animation':
        return <Figure attrs={attrs} />;

      case 'vc_gallery':
        return <Gallery attrs={attrs} />;

      case 'vc_single_image': {
        const src = mediaUrl(attrs.image);
        return src ? <Figure attrs={{ image_url: attrs.image, ...attrs }} /> : null;
      }

      // ---- interactive --------------------------------------------------
      case 'nectar_image_comparison':
        return <Compare attrs={attrs} />;

      case 'toggles':
        return <Toggles attrs={attrs} nodes={children} />;

      case 'toggle':
        // A lone toggle outside a [toggles] wrapper.
        return <Toggles attrs={{}} nodes={[node]} />;

      case 'tabbed_section':
        return <Tabs attrs={attrs} nodes={children} />;

      case 'testimonial_slider':
        return <Testimonials nodes={children} slider />;

      case 'testimonial':
        return <Testimonials nodes={[node]} />;

      case 'page_submenu':
        return <Submenu attrs={attrs} nodes={children} />;

      case 'nectar_blog':
        return <BlogFeed attrs={attrs} />;

      // ---- calls to action ----------------------------------------------
      case 'nectar_btn':
        return <Button attrs={attrs} />;

      case 'nectar_cta':
        return (
          <Cta attrs={attrs}>
            <Self nodes={children} />
          </Cta>
        );

      case 'nectar_icon':
        return <NectarIcon attrs={attrs} />;

      case 'fancy-ul':
      case 'text-with-icon':
        return <IconList attrs={attrs} nodes={children} kind={name} />;

      // ---- forms ---------------------------------------------------------
      case 'gravityform':
        return <NetlifyForm formId={attrs.id} />;

      // ---- embedded / nested content --------------------------------------
      case 'vc_raw_html': {
        const raw = children
          .map((c) => (c.kind === 'html' ? c.html : ''))
          .join('');
        const decoded = decodeRawHtml(raw);

        // The service-area map was pasted in as a whole HTML document.
        // Check this first: its JavaScript contains "[", which would
        // otherwise look like a shortcode below.
        if (/id="map"/.test(decoded) && /leaflet/i.test(decoded)) {
          return <ServiceAreaMap />;
        }

        // Some raw blocks just wrap another shortcode.
        if (/\[[a-z][a-z0-9_-]*[\s\]]/i.test(decoded) && !/<(?:script|style|html)\b/i.test(decoded)) {
          return <Self nodes={parseShortcodes(decoded)} />;
        }

        const isMap = /google\.com\/maps/.test(decoded);
        const isVideo = /youtube\.com|youtu\.be|vimeo\.com/.test(decoded);
        return (
          <div class={`embed ${isVideo ? 'embed--video' : isMap ? 'embed--map' : ''}`}>
            <Fragment set:html={cleanHtml(decoded)} />
          </div>
        );
      }

      case 'ls_content_block': {
        const block = blocks[attrs.id];
        return block ? <Self nodes={parseShortcodes(block.content)} /> : null;
      }

      case 'divider': {
        const h = spacing(attrs.custom_height) ?? '30px';
        const line = (attrs.line_type || '').toLowerCase();
        if (line.includes('full width line')) {
          return <hr class="divider divider--line" style={`margin:calc(${h} / 2) 0`} />;
        }
        if (line.includes('small line')) {
          return <hr class="divider divider--small" style={`margin:calc(${h} / 2) auto`} />;
        }
        return <div class="divider" style={`height:${h}`} aria-hidden="true" />;
      }

      // Unknown shortcode: render its children so no copy is lost.
      default:
        return <Self nodes={children} />;
    }
  })
}

<style is:global>
  .rich-text > *:last-child {
    margin-bottom: 0;
  }
  .rich-text img {
    border-radius: var(--radius);
  }
  .col > .rich-text + .rich-text {
    margin-top: 20px;
  }
</style>
