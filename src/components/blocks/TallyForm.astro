---
/**
 * Replaces the original Gravity Forms embeds with a Tally form.
 * Until a Tally ID is filled in for the matching key in src/lib/site.ts,
 * this renders a call-us fallback so no page ships a dead form slot.
 */
import { gravityFormMap, site, tallyForms } from '../../lib/site';

interface Props {
  /** The original Gravity Forms ID from the shortcode. */
  formId?: string;
  /** Or address a Tally form directly by key. */
  formKey?: keyof typeof tallyForms;
}
const { formId, formKey } = Astro.props;
const key = formKey ?? (formId ? gravityFormMap[formId] : undefined) ?? 'contact';
const tallyId = tallyForms[key];
const title = { contact: 'Contact us', quote: 'Get a quote', estimate: 'Schedule an estimate', referral: 'Referral form' }[key] ?? 'Contact us';
---
{
  tallyId ? (
    <div class="tally">
      <iframe
        data-tally-src={`https://tally.so/embed/${tallyId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
        loading="lazy"
        width="100%"
        height="500"
        title={title}
      ></iframe>
    </div>
  ) : (
    <div class="form-fallback">
      <h3>{title}</h3>
      <p>Call us and we'll get straight back to you.</p>
      <p class="form-fallback__actions">
        <a class="btn btn--accent btn--large" href={site.phoneHref}>{site.phone}</a>
        <a class="btn btn--dark btn--large" href={`mailto:${site.email}`}>Email us</a>
      </p>
    </div>
  )
}

{tallyId && <script is:inline async src="https://tally.so/widgets/embed.js"></script>}

<style>
  .tally {
    margin-bottom: 20px;
  }
  .form-fallback {
    background: var(--surface);
    border-left: 3px solid var(--accent);
    padding: 28px;
    margin-bottom: 20px;
    border-radius: var(--radius);
    color: var(--body-text);
  }
  .form-fallback :global(h3) {
    color: var(--ink);
  }
  .form-fallback__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
  }
</style>
