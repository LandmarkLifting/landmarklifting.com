---
/**
 * Salient nectar_image_comparison — a before/after slider.
 * Works without JS (shows the "before" image at 50%); the range input
 * drives the reveal when scripting is available.
 */
import { mediaAlt, mediaUrl } from '../../lib/content';

interface Props { attrs: Record<string, string>; }
const { attrs } = Astro.props;
const before = mediaUrl(attrs.image_url);
const after = mediaUrl(attrs.image_2_url);
const beforeAlt = mediaAlt(attrs.image_url, 'Before concrete lifting');
const afterAlt = mediaAlt(attrs.image_2_url, 'After concrete lifting');
---
{
  before && after && (
    <div class="compare" data-compare>
      <img class="compare__base" src={after} alt={afterAlt} loading="lazy" decoding="async" />
      <div class="compare__after" data-compare-clip>
        <img src={before} alt={beforeAlt} loading="lazy" decoding="async" />
      </div>
      <span class="compare__label compare__label--before">Before</span>
      <span class="compare__label compare__label--after">After</span>
      <span class="compare__handle" data-compare-handle></span>
      <input class="compare__range" type="range" min="0" max="100" value="50" step="0.1"
             aria-label="Reveal more of the before or after photo" data-compare-range />
    </div>
  )
}

<script>
  const setup = (el: HTMLElement) => {
    const clip = el.querySelector<HTMLElement>('[data-compare-clip]');
    const handle = el.querySelector<HTMLElement>('[data-compare-handle]');
    const range = el.querySelector<HTMLInputElement>('[data-compare-range]');
    const img = clip?.querySelector('img');
    if (!clip || !handle || !range || !img) return;

    const sync = () => {
      const pct = Number(range.value);
      clip.style.width = `${pct}%`;
      handle.style.left = `${pct}%`;
      img.style.width = `${el.clientWidth}px`;
    };
    range.addEventListener('input', sync);
    window.addEventListener('resize', sync);
    // Size the clipped image once its natural dimensions are known.
    if (img.complete) sync();
    else img.addEventListener('load', sync);
    sync();
  };
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach(setup);
</script>
