---
/**
 * Salient nectar_animated_title, style "color-strip-reveal": the heading text
 * sits on an accent strip that wipes in when scrolled into view.
 */
import { color, headingTag, isProseHeading } from '../../lib/render';

interface Props { attrs: Record<string, string>; }
const { attrs } = Astro.props;
const Tag = headingTag(attrs.heading_tag, 'h2') as any;
const strip = color(attrs.color) || 'var(--accent)';
// Over-long "headings" are really sentences: no strip reveal, prose styling.
const prose = isProseHeading(attrs.text);
---
{
  prose ? (
    <Tag class="h--prose" set:html={attrs.text ?? ''} />
  ) : (
    <Tag class="animated-title animate-in" style={`--strip:${strip}`}>
      <span class="animated-title__text" set:html={attrs.text ?? ''} />
    </Tag>
  )
}

<style>
  .animated-title {
    margin-bottom: 18px;
  }
  /* The strip is a background on an inline span. Without `box-decoration-break:
     clone` a heading that wraps paints one background across the whole inline
     box, which shows up as a stray underline beneath the first line only. With
     it, every line gets its own strip, and it is tall enough to read as the
     highlight Salient drew rather than a hairline. */
  .animated-title__text {
    display: inline;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    background-image: linear-gradient(var(--strip), var(--strip));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 0.3em;
    padding: 0 0.12em;
    margin: 0 -0.12em;
    transition: background-size 0.9s cubic-bezier(0.25, 1, 0.33, 1) 0.15s;
  }
  .animated-title.is-visible .animated-title__text {
    background-size: 100% 0.3em;
  }
  @media (prefers-reduced-motion: reduce) {
    .animated-title__text {
      background-size: 100% 0.3em;
      transition: none;
    }
  }
</style>
