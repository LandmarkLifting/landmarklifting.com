---
/** WPBakery vc_row / vc_row_inner. */
import { color, isLightColor, spacing, youtubeId } from '../../lib/render';
import { mediaUrl } from '../../lib/content';

interface Props {
  attrs: Record<string, string>;
  inner?: boolean;
  /** True when this row's columns paint their own background, i.e. are cards. */
  hasCards?: boolean;
}
const { attrs, inner = false, hasCards = false } = Astro.props;

const bgImage = mediaUrl(attrs.bg_image);
const bgColor = color(attrs.bg_color);
const overlay = color(attrs.color_overlay);
const strength = Number(attrs.overlay_strength ?? '0');
const hasOverlay = Boolean(overlay) && strength > 0;
/**
 * Salient chose light or dark text automatically from the row's background;
 * `text_color` was only stored when an author overrode it. Most dark rows in
 * the content never set it, so without this the copy renders dark on dark.
 */
const darkBg = bgColor ? isLightColor(bgColor) === false : false;
const darkOverlay = hasOverlay && strength >= 0.5 && isLightColor(overlay) === false;
// `text_color="dark"` is Salient's stored default, not an author's choice —
// nobody wants near-black copy on a #221e1e row — so it never wins here.
const light = attrs.text_color === 'light' || darkBg || darkOverlay;
const full = attrs.type === 'full_width_background' || attrs.type === 'full_width_content';
const video = youtubeId(attrs.video_external);

// WPBakery stores the row's jump-link anchor in `id` (older rows) or `el_id`.
const anchor = attrs.el_id || attrs.id || undefined;

const top = spacing(attrs.top_padding);
const bottom = spacing(attrs.bottom_padding);

const rowStyle = [
  bgColor ? `background-color:${bgColor}` : '',
  bgImage ? `background-image:url('${bgImage}')` : '',
  top ? `padding-top:${top}` : '',
  bottom ? `padding-bottom:${bottom}` : '',
].filter(Boolean).join(';');

/**
 * Cards in a row should share a height — and `equal_height` literally asks for
 * that, so it stretches rather than centring. Vertical placement only applies
 * when the columns are not cards.
 */
const alignItems =
  hasCards || attrs.equal_height === 'yes'
    ? 'stretch'
    : attrs.content_placement === 'middle'
      ? 'center'
      : attrs.content_placement === 'bottom'
        ? 'flex-end'
        : null;

/**
 * A row that puts light text over media always gets a legibility scrim — and a
 * background video always gets one regardless, because YouTube draws its own
 * player chrome over the frame and a semi-transparent colour overlay does not
 * hide it.
 */
const needsScrim = Boolean(video) || (light && Boolean(bgImage) && !hasOverlay);

const classes = [
  inner ? 'row row--flush row--inner' : 'row',
  full || bgImage || bgColor ? 'row--full' : '',
  light ? 'row--light' : '',
].filter(Boolean).join(' ');
---
{
  inner ? (
    <div class={classes} style={rowStyle} id={anchor}>
      <div class="row__inner" style={alignItems ? `--row-align:${alignItems}` : undefined}>
        <slot />
      </div>
    </div>
  ) : (
    <section class={classes} style={rowStyle} id={anchor}>
      {video && (
        <div class="row__video" aria-hidden="true">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video}?autoplay=1&mute=1&loop=1&controls=0&playsinline=1&playlist=${video}&modestbranding=1&rel=0&disablekb=1&fs=0&iv_load_policy=3&showinfo=0`}
            title="Background video"
            loading="lazy"
            tabindex="-1"
            allow="autoplay; encrypted-media"
          />
        </div>
      )}
      {hasOverlay && (
        <div class="row__overlay" style={`background-color:${overlay};opacity:${strength}`} />
      )}
      {/* Light type over a photo or video is unreadable without a scrim, and
          most of these rows never had one configured. Guarantee it. */}
      {needsScrim && <div class="row__scrim" />}
      <div class={`row__content container ${attrs.type === 'full_width_content' ? 'container--wide' : ''}`}>
        <div class="row__inner" style={alignItems ? `--row-align:${alignItems}` : undefined}>
          <slot />
        </div>
      </div>
    </section>
  )
}

<style>
  .row--inner {
    width: 100%;
  }
  /* Darker where the copy sits, clearing towards the right so the footage
     still reads. Sits above the video, which hides player chrome too. */
  .row__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(100deg, rgba(18, 15, 15, 0.93) 0%, rgba(18, 15, 15, 0.86) 42%, rgba(18, 15, 15, 0.62) 100%);
  }
  .row__video {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  /* Background footage is ambience, not a focal point: dim and desaturate it
     so the copy on top stays the thing you read. */
  .row__video {
    filter: brightness(0.62) saturate(0.75);
  }
  .row__video iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-height: 100%;
    min-width: 177.77vh;
    transform: translate(-50%, -50%);
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .row__video {
      display: none;
    }
  }
</style>
