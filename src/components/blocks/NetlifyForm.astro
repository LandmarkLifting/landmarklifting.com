---
/**
 * Renders a form from `src/lib/forms.ts` as a native Netlify form.
 *
 * Real markup, no iframe and no third-party script, so the page still works
 * with JavaScript off — the attribution fields simply post empty.
 *
 * Requirements Netlify imposes, all handled below:
 *   - `data-netlify="true"` and a unique `name`
 *   - a hidden `form-name` input matching that name, or the POST 404s
 *   - every field present in the static HTML, hidden ones included
 *   - `enctype="multipart/form-data"` when the form accepts a file
 *
 * The original used Cloudflare Turnstile for spam. That needs a site key and a
 * server to verify against, so this relies on Netlify's own spam filtering plus
 * the honeypot below. Add `data-netlify-recaptcha` if more is needed.
 */
import { forms, actionFor, ATTRIBUTION_FIELDS } from '../../lib/forms';
import { gravityFormMap, site } from '../../lib/site';

interface Props {
  /** The original Gravity Forms ID from the shortcode. */
  formId?: string;
  /** Or address a form directly by key. */
  formKey?: string;
}
const { formId, formKey } = Astro.props;
const key = formKey ?? (formId ? gravityFormMap[formId] : undefined) ?? 'quote';
const spec = forms[key] ?? forms.quote;
const action = actionFor(spec.name);
const hasFile = spec.fields.some((f) => f.type === 'file');
const maxFiles = spec.fields.find((f) => f.type === 'file')?.maxFiles ?? 0;

const autocompleteFor = (name: string) =>
  ({
    first_name: 'given-name',
    last_name: 'family-name',
    your_name: 'name',
    email: 'email',
    your_email: 'email',
    phone: 'tel',
    your_phone: 'tel',
    address_street: 'address-line1',
    address_line2: 'address-line2',
    address_city: 'address-level2',
    address_zip: 'postal-code',
  })[name];
---

<div class="nf">
  <h3 class="nf__heading">{spec.heading}</h3>
  {spec.intro && <p class="nf__intro">{spec.intro}</p>}

  <form
    name={spec.name}
    method="POST"
    action={action}
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    enctype={hasFile ? 'multipart/form-data' : undefined}
    class="nf__form"
    data-max-files={maxFiles || undefined}
  >
    {/* Netlify matches the POST back to the form by this value. */}
    <input type="hidden" name="form-name" value={spec.name} />

    {/* Honeypot: hidden from people, irresistible to bots. */}
    <p class="nf__pot">
      <label>Do not fill this in <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    {/* Filled by the script below; empty values post fine with JS off. */}
    {
      spec.attribution &&
        ATTRIBUTION_FIELDS.map((f) => (
          <input type="hidden" name={f} value="" data-attr={f} />
        ))
    }

    <div class="nf__grid">
      {
        spec.fields.map((f) => {
          const id = `${spec.name}-${f.name}`;
          const wide = f.wide || f.type === 'textarea' || f.type === 'file';

          if (f.type === 'checkbox') {
            return (
              <p class="nf__field nf__field--wide nf__consent">
                <span class="nf__check">
                  <input id={id} name={f.name} type="checkbox" value="yes" required={f.required} />
                  {f.labelHtml ? (
                    <label class="nf__check-label" for={id} set:html={f.labelHtml} />
                  ) : (
                    <label class="nf__check-label" for={id}>
                      {f.label}
                    </label>
                  )}
                </span>
                {f.hint && <span class="nf__consent-text">{f.hint}</span>}
              </p>
            );
          }

          return (
            <p class={`nf__field${wide ? ' nf__field--wide' : ''}`}>
              <label class="nf__label" for={id}>
                {f.label}
                {f.required && <abbr class="nf__req" title="required">*</abbr>}
              </label>

              {f.type === 'textarea' ? (
                <textarea id={id} name={f.name} rows="5" required={f.required} />
              ) : f.type === 'select' ? (
                <select id={id} name={f.name} required={f.required}>
                  <option value="">Please choose…</option>
                  {f.options?.map((o) => <option value={o}>{o}</option>)}
                </select>
              ) : (
                <input
                  id={id}
                  name={f.name}
                  type={f.type}
                  required={f.required}
                  accept={f.accept}
                  multiple={f.multiple}
                  autocomplete={autocompleteFor(f.name)}
                />
              )}

              {f.hint && <span class="nf__hint">{f.hint}</span>}
            </p>
          );
        })
      }
    </div>

    <div class="nf__actions">
      <button type="submit" class="btn btn--accent btn--large">{spec.submitLabel}</button>
      <span class="nf__alt">
        or call <a href={site.phoneHref}>{site.phone}</a>
      </span>
    </div>
  </form>
</div>

<script is:inline>
  (function () {
    // Fill this form's hidden attribution fields from the stored first touch.
    var attr = {};
    try {
      var raw = localStorage.getItem('ll_attr');
      if (raw) attr = JSON.parse(raw) || {};
    } catch (e) {
      /* storage unavailable — post without attribution */
    }
    attr.page_submitted_from = window.location.pathname;
    attr.user_agent = navigator.userAgent;

    var inputs = document.querySelectorAll('input[data-attr]');
    for (var i = 0; i < inputs.length; i++) {
      var k = inputs[i].getAttribute('data-attr');
      var v = attr[k];
      // Never post the literal string "undefined" — the old form did, and it
      // poisoned 493 GCLID values.
      if (v === undefined || v === null || v === 'undefined') continue;
      inputs[i].value = String(v);
    }

    // Enforce the original's 5-photo limit.
    var forms = document.querySelectorAll('form[data-max-files]');
    for (var j = 0; j < forms.length; j++) {
      (function (form) {
        var max = parseInt(form.getAttribute('data-max-files'), 10);
        var file = form.querySelector('input[type="file"]');
        if (!file || !max) return;
        file.addEventListener('change', function () {
          if (file.files && file.files.length > max) {
            alert('Please choose no more than ' + max + ' photos.');
            file.value = '';
          }
        });
      })(forms[j]);
    }
  })();
</script>

<style>
  .nf {
    background: var(--surface);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
    color: var(--body-text);
  }
  .nf__heading {
    color: var(--ink);
    margin-top: 0;
  }
  .nf__intro {
    margin-top: 0;
    max-width: var(--measure);
  }
  .nf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }
  @media (max-width: 640px) {
    .nf__grid {
      grid-template-columns: 1fr;
    }
  }
  .nf__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
  }
  .nf__field--wide {
    grid-column: 1 / -1;
  }
  .nf__label {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--ink);
  }
  .nf__req {
    color: var(--accent);
    text-decoration: none;
    margin-left: 2px;
  }
  .nf input:not([type='checkbox']),
  .nf select,
  .nf textarea {
    width: 100%;
    padding: 12px 14px;
    font: inherit;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .nf textarea {
    resize: vertical;
  }
  .nf input:focus-visible,
  .nf select:focus-visible,
  .nf textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .nf input[type='file'] {
    padding: 10px;
    background: var(--surface-2);
  }
  .nf__hint {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .nf__consent {
    gap: 8px;
    margin-top: var(--space-2xs);
  }
  .nf__check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .nf__check input[type='checkbox'] {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    flex: none;
    accent-color: var(--accent);
  }
  .nf__check-label {
    font-size: 0.95rem;
    color: var(--ink);
  }
  /* TCPA wording — small, but it must stay legible. */
  .nf__consent-text {
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: var(--measure);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  .nf__alt {
    font-size: 0.95rem;
    color: var(--muted);
  }
  /* Off-screen rather than display:none — some bots skip hidden inputs. */
  .nf__pot {
    position: absolute;
    left: -5000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
