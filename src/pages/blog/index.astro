---
/** WordPress blog index (page_for_posts = 1112). */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { BLOG_PAGE_ID, categories, docById, mediaUrl, permalink, posts } from '../../lib/content';
import { site } from '../../lib/site';

const doc = docById(BLOG_PAGE_ID);
const cats = categories();
const title = doc?.seo.title || `Blog | ${site.name}`;
---
<Base
  title={title}
  description={doc?.seo.description || 'Concrete lifting news, projects and advice from Landmark Lifting.'}
>
  <PageHero
    title={doc?.title || 'Blog'}
    header={{
      bg: doc?.page_header.bg ?? null,
      bg_color: null, height: null, font_color: null,
      alignment: null, parallax: null,
      subtitle: doc?.page_header.subtitle ?? 'Landmark Lifting',
    }}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }]}
  />

  <div class="container blog-index">
    {cats.length > 0 && (
      <nav class="blog-index__cats" aria-label="Categories">
        {cats.map((c) => (
          <a class="blog-index__cat" href={`/category/${c.slug}/`}>{c.name} ({c.count})</a>
        ))}
      </nav>
    )}

    <div class="post-grid">
      {posts.map((p) => {
        const img = mediaUrl(p.featured_image);
        return (
          <article class="post-card">
            <a href={permalink(p)}>
              {img && <img src={img} alt="" loading="lazy" decoding="async" />}
              <h2 set:html={p.title} />
              {p.seo.description && <p set:html={p.seo.description} />}
            </a>
          </article>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .blog-index {
    padding: var(--section-y) 0 var(--space-xl);
  }
  .blog-index__cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }
  .blog-index__cat {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 16px;
    font-family: var(--font-head);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    transition: background-color var(--transition), border-color var(--transition), color var(--transition);
  }
  .blog-index__cat:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .post-grid {
    display: grid;
    gap: var(--space-xl) var(--space-lg);
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .post-card a {
    display: block;
    color: inherit;
  }
  .post-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-md);
    transition: transform 0.5s var(--ease), box-shadow var(--transition);
  }
  .post-card a:hover img {
    transform: scale(1.02);
    box-shadow: var(--shadow);
  }
  .post-card h2 {
    font-size: 1.25rem;
    line-height: 1.3;
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: var(--space-xs);
    transition: color var(--transition);
  }
  .post-card a:hover h2 {
    color: var(--accent);
  }
  .post-card p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* The image is the only thing that should move on hover. */
  @media (prefers-reduced-motion: reduce) {
    .post-card a:hover img { transform: none; }
  }
</style>
